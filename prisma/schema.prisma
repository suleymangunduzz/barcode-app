generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // 'admin' | 'staff'
  createdAt    DateTime @default(now())
  sales        Sale[]   @relation("UserSales")
}

model Category {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  items     Item[]
  createdAt DateTime @default(now())
}

model Item {
  id                Int      @id @default(autoincrement())
  barcode           String   @unique
  name              String
  brand             String?
  model             String?
  categoryId        Int?
  category          Category? @relation(fields: [categoryId], references: [id])
  currentPrice      Float
  stockQuantity     Int       @default(0)
  minStockThreshold Int       @default(0)
  imagePath         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  itemId         Int
  item           Item     @relation(fields: [itemId], references: [id])
  changeQuantity Int
  reason         String   // 'sale' | 'restock' | 'manual_adjustment'
  referenceId    Int?
  createdAt      DateTime @default(now())
}

model Sale {
  id          Int       @id @default(autoincrement())
  totalAmount Float
  soldById    Int?
  soldBy      User?     @relation("UserSales", fields: [soldById], references: [id])
  createdAt   DateTime  @default(now())
  saleItems   SaleItem[]
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  sale       Sale     @relation(fields: [saleId], references: [id])
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id])
  itemName   String
  barcode    String
  quantity   Int
  unitPrice  Float
  totalPrice Float
}
