{
  "name": "barcode-app-electron",
  "version": "0.1.0",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && electron dist/main.js",
    "build": "tsc -p tsconfig.node.json",
    "dist": "electron-builder",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "ts-node --project tsconfig.node.json prisma/seed.ts",
    "view:db": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "prisma": "^5.22.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.barcode.app",
    "asar": true,
    "files": [
      "dist/**/*",
      "prisma/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/preload.js",
        "to": "preload.js"
      },
      {
        "from": "../renderer/dist",
        "to": "renderer"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
