{
  "name": "barcode-app",
  "private": true,
  "workspaces": [
    "electron",
    "renderer"
  ],
  "scripts": {
    "install:all": "npm --prefix electron install && npm --prefix renderer install",
    "build:electron": "npm --prefix electron run build",
    "dev:electron": "npm --prefix electron run start",
    "dev:renderer": "npm --prefix renderer run dev",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "prisma:migrate": "npm --prefix electron run prisma:migrate",
    "prisma:seed": "npm --prefix electron run prisma:seed",
    "view:db": "npm --prefix electron run view:db",
    "generate:types": "ts-node scripts/generate-prisma-types.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
